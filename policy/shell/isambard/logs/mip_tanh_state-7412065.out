    name:                                xqc_style
    hidden_dims_critic:                  [512, 512, 512, 512]
    n_critics:                           2
    critic_loss:                         categorical
    max_v:                               5.0
    min_v:                               -5.0
    pre_activation_bn:                   True
    use_layer_norm:                      False
    use_batch_norm:                      True
    skip_connections:                    False
    use_weight_norm:                     True
  reset_freq:                            0
  reward_normalization:                  True
