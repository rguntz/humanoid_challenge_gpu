  rollout_best_of_n:                     1
  To:                                    2
  Ta:                                    16
  execution_horizon:                     8
  dim_mult:                              [1, 2, 2]
  mask_reference_region:                 True
  camera_keys:                           []
  batch_size:                            256
  model_dim:                             256
  emb_dim:                               256
  lowdim_normalizer:                     global
  kernel_size:                           5
  cond_predict_scale:                    True
  n_groups:                              8
  use_stationary_unet:                   False
  bottleneck_dim:                        24
  feature_dimension:                     128
  stationary_activation:                 sin_cos
  w_mean_stddev:                         0.001
  stationary_mode:                       concat
  log_ls_init:                           -5.0
  stationary_features_variant:           default
  num_encoder_layers:                    2
  eef_pos_dim:                           3
  eef_quat_dim:                          4
  lr:                                    0.0001
  weight_decay:                          1e-06
  beta1:                                 0.95
  beta2:                                 0.999
