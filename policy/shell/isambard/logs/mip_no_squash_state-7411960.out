      h:                                 8
      discount:                          0.99
      val_ratio:                         0.15
      abs_action:                        True
      batch_size:                        256
      num_steps:                         100000
      log_every:                         200
      val_every:                         1000
    seed:                                0
    critic_lr:                           0.0003
    weight_decay:                        0.0
    tau:                                 0.005
    target_net_update_freq:              1
    critic_pre_training_steps:           100000
    name:                                xqc_style
    hidden_dims_critic:                  [512, 512, 512, 512]
    n_critics:                           2
    critic_loss:                         categorical
    max_v:                               5.0
    min_v:                               -5.0
    pre_activation_bn:                   True
    use_layer_norm:                      False
    use_batch_norm:                      True
    skip_connections:                    False
    use_weight_norm:                     True
  reset_freq:                            0
  reward_normalization:                  True
  fix_reward_normalization_scale_jump:   True
  offline_data_ratio:                    0.5
  n_demos:                               None
  pretrain_use_sarsa:                    True
  critic_bootstrap_use_ema:              False
  critic_bootstrap_best_of_n:            1
  rollout_best_of_n:                     1
  To:                                    2
  Ta:                                    16
  execution_horizon:                     8
  dim_mult:                              [1, 2, 2]
  mask_reference_region:                 True
  camera_keys:                           []
  batch_size:                            256
  model_dim:                             256
  emb_dim:                               256
  lowdim_normalizer:                     global
  kernel_size:                           5
  cond_predict_scale:                    True
  n_groups:                              8
  use_stationary_unet:                   False
  bottleneck_dim:                        24
  feature_dimension:                     128
  stationary_activation:                 sin_cos
  w_mean_stddev:                         0.001
  stationary_mode:                       concat
  log_ls_init:                           -5.0
  stationary_features_variant:           default
  num_encoder_layers:                    2
  eef_pos_dim:                           3
  eef_quat_dim:                          4
  lr:                                    0.0001
  weight_decay:                          1e-06
  beta1:                                 0.95
  beta2:                                 0.999
  grad_clip_norm:                        None
  lr_schedule:                           cosine_warmup
