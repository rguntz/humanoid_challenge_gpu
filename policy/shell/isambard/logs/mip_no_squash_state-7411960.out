  ema_rate:                              0.995
  ema_schedule:                          warmup
  ema_power:                             0.75
  ema_max_value:                         0.9999
  ema_rate_online:                       1.0
  actor_pre_training_steps:              100000
  log_gradient_metrics:                  False
  wasserstein_regularization:            3.0
  wasserstein_offline_only:              False
